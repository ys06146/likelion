# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
APP_ENV=development
# Local defaults preserve backend/oraq_app.db. Production MUST use persistent storage.
# DATA_DIR=/data
# DATABASE_URL=postgresql+psycopg://user:password@host/db
CORS_ORIGINS=http://localhost:7357,http://127.0.0.1:7357
# Optional Google login: same client ID as the Flutter build.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: serve the Flutter build from this API.
# WEB_DIR=../oral_health_ai/build/web
